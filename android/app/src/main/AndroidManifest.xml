<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          screenOrientation="fullUser": 4방향 모두 허용하되 기기의 화면 회전 잠금 설정은 따른다.
          (fullSensor 는 사용자가 회전을 잠가둬도 무시하고 돌아가 버린다.)
          configChanges 에 orientation|screenSize 가 이미 있어 회전해도 액티비티가 재생성되지 않는다
          — WebView 가 살아있으니 three.js 컨텍스트·게임 상태가 그대로 유지된다.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aquaworld.app" android:host="oauth" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM 기본 알림 채널 (Android 8+ 필수). 채널 자체는 PushNotifications.createChannel 로 생성. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aquaworld_default" />

        <!-- 알림 상태바 small icon (흰색 단색 실루엣). 미지정 시 앱 런처 아이콘이 회색 사각형으로 표시됨. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <!-- 흰색 실루엣에 적용되는 틴트 색 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/aquaworld_notification" />

        <!-- AdMob APPLICATION_ID (실 계정). 광고 단위 ID(.env VITE_ADMOB_REWARDED_ANDROID)와
             퍼블리셔 ID 가 같아야 한다. 개발 중에는 실 광고를 요청하지 않도록
             .env 의 VITE_ADMOB_TEST_DEVICES 에 기기 해시를 등록하거나
             VITE_ADMOB_USE_TEST_ADS=true 로 테스트 단위를 강제할 것. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2189275813205372~8805884871" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 런타임 알림 권한. 미만 버전은 자동 허용. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 포토 모드 갤러리 저장(GallerySaverPlugin). Android 10+ 는 scoped storage 라
         MediaStore 로 권한 없이 쓰므로, 공용 Pictures 에 직접 써야 하는 9 이하에서만 요청된다. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
