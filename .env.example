VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_public_key
VITE_KAKAO_JS_KEY=your_kakao_javascript_key
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=Client_Secret_Code
# 카카오 네이티브 OAuth 의 https 중계 redirect URI (Firebase Hosting). 기본값은 src/services/platform.ts 참고.
VITE_KAKAO_NATIVE_REDIRECT=https://aquaworld-bf2f4.web.app/oauth/kakao.html
# AdMob 보상형 광고 단위 ID (Android). 미설정 시 Google 공식 테스트 단위로 폴백.
# AndroidManifest 의 APPLICATION_ID meta 도 같이 교체해야 함 (테스트: ca-app-pub-3940256099942544~3347511713)
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917
# 개발/QA 기기 해시 (콤마 구분). 등록된 기기는 실 광고 단위 그대로 테스트 광고를 받아
# 노출/수익에 집계되지 않는다. 해시는 앱 실행 직후 logcat 의
# "Use RequestConfiguration.Builder().setTestDeviceIds(Arrays.asList("XXXX"))" 줄에서 확인.
VITE_ADMOB_TEST_DEVICES=
# true 면 광고 단위 자체를 Google 공식 테스트 단위로 강제한다(실 광고를 아예 요청하지 않음).
# 개발/QA 빌드에서 실 광고를 반복 요청·시청하면 무효 트래픽으로 계정이 제재될 수 있다.
VITE_ADMOB_USE_TEST_ADS=false
VITE_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
VITE_SENTRY_ENVIRONMENT=production
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=your_project_slug
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx